# ---------------------------------------------------------------------------
# Vityl — environment variables.  Copy this file to ".env.local" and fill in.
# ---------------------------------------------------------------------------

# Supabase. Create a free project at https://supabase.com, then find these under
# Project Settings -> API.  The service-role key is server-only — never expose it
# to the browser. It is used here only inside server code (API routes / RSC).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Claude API key — powers the nutrition assistant.
# Create one at https://console.anthropic.com  (Settings -> API Keys).
# Server-only; never exposed to the browser.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Note: APP_PASSWORD and SYNC_TOKEN are no longer used. Phase 5 replaced the
# single passphrase with real accounts, and each user now has their own
# activity-sync token (shown on the Profile screen).
